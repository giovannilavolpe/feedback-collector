# Copiá este archivo a `.env` (en la raíz) y completá los valores.
# El archivo `.env` NO se sube al repo.

# Base de datos PostgreSQL (creá la base vacía antes de levantar la API)
DB_DATABASE=FeedBack-Collector
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Clave para firmar los JWT (usá un valor largo y aleatorio)
JWT_SECRET=

# --- Solo para despliegue (instancia compartida) ---
# Si está definida, se usa en lugar de las variables DB_* de arriba.
DATABASE_URL=postgres://usuario:clave@host:5432/base
# Poné true si tu Postgres gestionado exige SSL (Render externo, Neon, Supabase...)
# DB_SSL=false
# El puerto lo suele asignar la plataforma (PORT). Por defecto 3000.
# PORT=3000
